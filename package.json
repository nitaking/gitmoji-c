{
  "name": "gitmoji-c",
  "description": "gitmoji-c is a gitmoji-cli clone tool that does not use gpg.",
  "version": "1.0.8",
  "author": "nitaking",
  "bin": {
    "gitmoji": "./bin/run"
  },
  "bugs": "https://github.com/nitaking/gitmoji-c/issues",
  "dependencies": {
    "@oclif/core": "^4.14.0",
    "@oclif/plugin-help": "^6.3.0",
    "chalk": "^4.1.2",
    "execa": "^9.6.1",
    "inquirer": "^9.3.8",
    "inquirer-autocomplete-prompt": "^3.0.1"
  },
  "devDependencies": {
    "@oclif/test": "^4.2.0",
    "@types/inquirer": "^9.0.10",
    "@types/inquirer-autocomplete-prompt": "^3.0.3",
    "@types/node": "^20.19.43",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "eslint": "^9.39.5",
    "oclif": "^4.24.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  },
  "packageManager": "bun@1.3.10",
  "engines": {
    "node": ">=20.0.0"
  },
  "files": [
    "/bin",
    "/lib",
    "/oclif.manifest.json"
  ],
  "homepage": "https://github.com/nitaking/gitmoji-c",
  "keywords": [
    "oclif",
    "gitmoji"
  ],
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "oclif": {
    "commands": "./lib/commands",
    "bin": "gitmoji",
    "plugins": [
      "@oclif/plugin-help"
    ]
  },
  "repository": "nitaking/gitmoji-c",
  "scripts": {
    "build": "tsc -b",
    "lint": "eslint src/",
    "postpack": "rm -f oclif.manifest.json",
    "prepack": "rm -rf lib && tsc -b && oclif manifest",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "types": "lib/index.d.ts"
}
